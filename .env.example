# Servidor (a porta 3000 fica livre para outros sistemas; o app usa 3100)
PORT=3100
NODE_ENV=development
# true quando a API roda atrás de um proxy (Render, Railway, nginx), para o
# limitador de tentativas enxergar o IP real de quem chamou.
TRUST_PROXY=false

# Autenticação
# Gere um segredo próprio, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obrigatório com NODE_ENV=production (valores de exemplo são recusados).
# Vazio fora de produção: a API gera um segredo aleatório e o guarda em
# `.jwt-secret`, ao lado do banco.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Recuperação de senha
RESET_CODE_TTL_MINUTES=30
# Devolve o código na resposta de /auth/forgot-password (não há envio de
# e-mail ainda). Só para testes e demonstração; proibido em produção.
EXPOSE_RESET_CODE=false

# Limite de tentativas em login, forgot-password, reset-password e
# change-password: por IP + e-mail, dentro da janela (por IP: 5 vezes isso).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Economia de pontos: teto semanal de pontos de ações (ECONOMIA-DE-PONTOS.md)
WEEKLY_POINTS_CAP=400

# Banco SQLite (relativo à pasta onde o processo roda)
DB_PATH=./data/eco.db

# CORS: `*` libera qualquer origem; em produção use uma lista separada por vírgula
CORS_ORIGIN=*
