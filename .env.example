# Server
PORT=3000
NODE_ENV=development

# Auth
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Password reset code
RESET_CODE_TTL_MINUTES=30

# SQLite database file (relative to the process working directory)
DB_PATH=./data/eco.db
