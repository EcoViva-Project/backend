# Server
PORT=3000
NODE_ENV=development

# Auth
# Gere um segredo forte, por exemplo `openssl rand -hex 32` (64 caracteres hex).
# Obrigatorio quando NODE_ENV=production: o valor padrao de desenvolvimento e recusado.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Password reset code
RESET_CODE_TTL_MINUTES=30

# SQLite database file (relative to the process working directory)
DB_PATH=./data/eco.db

# CORS: `*` libera qualquer origem; em producao use uma lista separada por virgula
CORS_ORIGIN=*
