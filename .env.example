# Servidor (a porta 3000 fica livre para outros sistemas; o app usa 3100)
PORT=3100
# Endereço em que a API escuta. 127.0.0.1 (padrão): só este computador.
# 0.0.0.0 abre a API para a rede (outros aparelhos do mesmo Wi-Fi podem
# chamá-la, inclusive com a conta de demonstração, que tem senha pública).
HOST=127.0.0.1
# development, test ou production (sem diferenciar maiúsculas; prod = production).
# EXPOSE_RESET_CODE=true e JWT_SECRET curto só valem com development ou test
# escritos; vazio ou outro nome conta como ambiente sem essas liberações.
NODE_ENV=development
# Atrás de um proxy (Render, Railway, nginx), para o limitador de tentativas
# enxergar o IP real de quem chamou. Valores aceitos:
#   false (ou vazio, ou 0)  desligado: a API recebe as conexões direto
#   1, 2...                 quantos proxies há na frente da API (o comum é 1)
#   loopback, 10.0.0.0/8    lista de IPs/sub-redes dos proxies, separados por vírgula
# Nunca "confiar em todos": o valor antigo true vale como 1.
TRUST_PROXY=false

# Autenticação
# Gere um segredo próprio, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obrigatório com NODE_ENV=production. Valores de exemplo (como os que já
# estiveram neste arquivo ou "change-me") são recusados em qualquer ambiente,
# menos test. Vazio fora de produção: a API gera um segredo aleatório e o
# guarda em `.jwt-secret`, ao lado do banco.
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Recuperação de senha
RESET_CODE_TTL_MINUTES=30
# Devolve o código na resposta de /auth/forgot-password (não há envio de
# e-mail ainda). Só para testes e demonstração: true só é aceito com
# NODE_ENV=development ou NODE_ENV=test.
EXPOSE_RESET_CODE=false

# Limite de tentativas em register, login, forgot-password, reset-password e
# change-password: por IP + e-mail, dentro da janela (por IP: 5 vezes isso).
# A recuperação de senha tem ainda limites fixos por conta, independentes do
# IP: 3 códigos novos por hora e 10 códigos errados a cada 24 horas.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Economia de pontos: teto semanal de pontos de ações (ECONOMIA-DE-PONTOS.md)
WEEKLY_POINTS_CAP=400

# Banco SQLite (relativo à pasta onde o processo roda)
DB_PATH=./data/eco.db

# CORS: `*` libera qualquer origem; em produção use uma lista separada por vírgula
CORS_ORIGIN=*
